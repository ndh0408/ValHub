+
+/// S10 daily-shop card: tier-tinted gradient, render, name, price, badges.
+class DailyOfferCard extends ConsumerWidget {
+  const DailyOfferCard({super.key, required this.offer, required this.puuid});
+
+  final DailyOffer offer;
+  final String puuid;
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final db = ref.watch(contentProvider).value ?? ContentDb.empty();
+    final skin = db.skinByLevelUuid(offer.skinLevelUuid);
+    final tint = contentTierTint(
+      ref,
+      skin?.contentTierUuid,
+      fallback: valColorsOf(context).muted,
+    );
+    final owned =
+        ref
+            .watch(ownedItemsProvider(puuid))
+            .value
+            ?.isSkinOwned(offer.skinLevelUuid) ??
+        false;
+    final wishlist = ref.watch(wishlistProvider(puuid));
+    final inWishlist = wishlistContains(wishlist, offer.skinLevelUuid, db);
+    final scheme = Theme.of(context).colorScheme;
+
+    return Semantics(
+      button: true,
+      label: skin?.displayName ?? CommonStrings.unknownItem,
+      child: InkWell(
+        borderRadius: BorderRadius.circular(12),
+        onTap: () => showSkinDetailSheet(
+          context,
+          skinOrLevelUuid: offer.skinLevelUuid,
+          mode: SkinDetailMode.store,
+        ),
+        child: Ink(
+          decoration: BoxDecoration(
+            borderRadius: BorderRadius.circular(12),
+            gradient: LinearGradient(
+              begin: Alignment.topCenter,
+              end: Alignment.bottomCenter,
+              colors: [
+                tint.withValues(alpha: 0.32),
+                tint.withValues(alpha: 0.06),
+              ],
+            ),
+          ),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              Expanded(
+                child: Stack(
+                  fit: StackFit.expand,
+                  children: [
+                    Padding(
+                      padding: const EdgeInsets.all(8),
+                      child: NetImage(
+                        skin?.render ?? skin?.image,
+                        fit: BoxFit.contain,
+                      ),
+                    ),
+                    Positioned(
+                      top: 4,
+                      right: 4,
+                      child: WishlistHeartButton(
+                        active: inWishlist,
+                        onTap: () => unawaited(
+                          ref
+                              .read(wishlistProvider(puuid).notifier)
+                              .toggleSkin(offer.skinLevelUuid, db),
+                        ),
+                      ),
+                    ),
+                    if (owned)
+                      Positioned(
+                        top: 4,
+                        left: 4,
+                        child: StoreBadge(
+                          StoreStrings.ownedBadge,
+                          color: scheme.primary,
+                        ),
+                      ),
+                  ],
+                ),
+              ),
+              Padding(
+                padding: const EdgeInsets.fromLTRB(10, 0, 10, 10),
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    ContentTierBadge(
+                      contentTierUuid: skin?.contentTierUuid,
+                      size: 14,
+                    ),
+                    const SizedBox(height: 2),
+                    Text(
+                      skin?.displayName ?? CommonStrings.unknownItem,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: Theme.of(context).textTheme.labelLarge,
+                    ),
+                    const SizedBox(height: 4),
+                    offer.vpCost == null
+                        ? const Text(CommonStrings.dash)
+                        : CurrencyAmount.vp(offer.vpCost!),
+                  ],
+                ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
