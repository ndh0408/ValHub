# Copy to .env and fill in (chmod 600 .env). Generate secrets with:  openssl rand -hex 32
# SESSION_SECRET and PEPPER are REQUIRED and must be at least 32 characters; the server refuses to start otherwise.

# HS256 key for community session tokens. Replacing it logs everyone out of the community tab, unless you rotate:
# put the old value in SESSION_SECRET_PREV (tokens signed with it stay valid), set a new SESSION_SECRET, restart,
# and remove SESSION_SECRET_PREV after 30 days.
SESSION_SECRET=
SESSION_SECRET_PREV=

# Salt for user ids: id = hex(sha256(PEPPER + puuid))[0..32]. It also salts the hashed IPs used for rate limits.
# NEVER change it after launch: every user would get a new id and lose their posts/votes.
PEPPER=
# Alternatively mount files and set SESSION_SECRET_FILE / SESSION_SECRET_PREV_FILE / PEPPER_FILE.
# Leave the corresponding direct variable empty; setting both is rejected.

# Public origin the app reaches (the Cloudflare Tunnel hostname), used for media URLs.
# Required HTTPS origin in production; placeholders are rejected. Example: https://val.gianguyen.cloud
# Development only: empty derives it from the request.
PUBLIC_BASE_URL=

# Believe CF-Connecting-IP (client address) and X-Forwarded-Proto/Host. The server's own default is false; this
# compose stack is reached through the Cloudflare Tunnel only, so it defaults to true here. Leave it false for any
# server that is reachable without Cloudflare (a client could otherwise pick its own rate-limit identity).
TRUST_PROXY=true

# --- Storage limits -----------------------------------------------------------------------------------------
# Per-user image quota (MB) and total image storage cap (MB). Beyond the user quota an upload is refused with
# 400 invalid_input; beyond the total cap with 507 storage_full.
MEDIA_USER_QUOTA_MB=50
MEDIA_MAX_TOTAL_MB=2048

# --- Abuse resistance ---------------------------------------------------------------------------------------
# Requests WITHOUT a session per client IP per minute (feed, skins, communities) and for image files.
ANON_READ_LIMIT_PER_MIN=600
ANON_MEDIA_LIMIT_PER_MIN=1500
# Seconds anonymous aggregate responses (skin top / votes / summary / reviews, communities) are cached; 0 = off.
PUBLIC_CACHE_TTL_SECONDS=45
# Seconds an anonymous feed page (GET /v1/posts) is cached and shared by every anonymous viewer; 0 = off.
PUBLIC_FEED_CACHE_SECONDS=5
# Requests per signed-in user per minute in total (any method / route), and the event-loop lag in ms above which
# requests are answered 503 server_busy (load shedding; 0 = off).
USER_REQUEST_LIMIT_PER_MIN=240
LOAD_SHED_LAG_MS=250
# Seconds Cloudflare's edge may keep an image. 0 = never (deleted / hidden images disappear at once). Devices always
# cache images for a year. See README "Cloudflare and media caching".
MEDIA_EDGE_CACHE_SECONDS=0
# Keep true until updated clients obtain partyCode from POST /v1/lfg/:id/join before joining Riot.
LFG_CODE_IN_LIST=true

# --- Backups (valvn-backup service) -------------------------------------------------------------------------
# Host directory for the archives (create it: mkdir -p backups && chown 1000:1000 backups && chmod 700 backups),
# how long they are kept and how often they are taken. Deleted user data survives in backups until they age out.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# Optional: age public recipient and a reviewed uploader executable mounted in the backup container.
# The hook receives BACKUP_FILE pointing only to encrypted .tgz.age. Keep the private key off-host.
# Enforce <=14-day retention remotely and preserve the current erasure ledger independently.
BACKUP_AGE_RECIPIENT=
BACKUP_OFFSITE_CMD=

# Optional monitoring profile: docker compose --profile monitoring up -d
# Mount an operator-reviewed executable at this absolute path in an override file.
# Receives fixed arguments: alert|recovered and alert codes; no user content or app secrets.
WATCHDOG_ALERT_HOOK=
WATCHDOG_INTERVAL_SECONDS=60

# Usually left as-is (set in docker-compose.yml).
# PORT=8080
# DATA_DIR=/data
