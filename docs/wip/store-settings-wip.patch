+import 'package:material_ui/material_ui.dart';
+
+import '../../../../core/domain/economy/economy.dart';
+import '../../../../core/ui/countdown_text.dart';
+import '../../../../core/ui/empty_view.dart';
+import '../../store_strings.dart';
+import 'accessory_row.dart';
+
+/// S12 body: countdown row, 4 rows of accessories.
+class AccessorySection extends StatelessWidget {
+  const AccessorySection({super.key, required this.accessoryStore});
+
+  final AccessoryStore? accessoryStore;
+
+  @override
+  Widget build(BuildContext context) {
+    final store = accessoryStore;
+    if (store == null || store.offers.isEmpty) {
+      return const Padding(
+        padding: EdgeInsets.symmetric(vertical: 24),
+        child: EmptyView(message: StoreStrings.accessoryEmpty),
+      );
+    }
+    final theme = Theme.of(context);
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        if (store.expiresAt != null)
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 0, 16, 4),
+            child: Row(
+              children: [
+                Icon(
+                  Icons.schedule,
+                  size: 16,
+                  color: theme.colorScheme.onSurfaceVariant,
+                ),
+                const SizedBox(width: 6),
+                CountdownText(
+                  expiresAt: store.expiresAt!,
+                  builder: StoreStrings.accessoryRefreshIn,
+                  style: theme.textTheme.bodyMedium,
+                ),
+              ],
+            ),
+          ),
+        ListView.separated(
+          padding: const EdgeInsets.symmetric(vertical: 8),
+          physics: const NeverScrollableScrollPhysics(),
+          shrinkWrap: true,
+          itemCount: store.offers.length,
+          separatorBuilder: (_, _) => const Divider(height: 1),
+          itemBuilder: (context, i) => AccessoryRow(offer: store.offers[i]),
+        ),
+      ],
+    );
+  }
+}
