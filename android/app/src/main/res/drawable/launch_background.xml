<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash: the app's dark navy, so there is no white flash before
     the (dark) Flutter UI draws its first frame. Android 12+ adds the
     launcher icon on top by itself. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/ic_launcher_background" />
    </item>
</layer-list>
