# i18n (docs/design/I18N.md 3.4)
#
# Code generated by `flutter gen-l10n`: committed, never hand-edited. Marked as
# generated so GitHub collapses it in diffs. `eol=lf` keeps the blobs identical
# whatever the author's OS / core.autocrlf (gen-l10n writes CRLF on Windows),
# which is what the CI check `flutter gen-l10n && git diff --exit-code
# lib/l10n/gen` relies on.
lib/l10n/gen/** text eol=lf linguist-generated=true

# Translation sources and per-locale status: LF everywhere so tool output
# (tool/l10n_fmt.dart --check) is byte-stable across machines.
lib/l10n/arb/*.arb text eol=lf
lib/l10n/status/*.json text eol=lf
