+class _NotificationsSection extends ConsumerWidget {
+  const _NotificationsSection();
+
+  /// Turning a notification toggle on primes the OS permission the first
+  /// time it is needed (S04), then persists the preference either way.
+  Future<void> _toggle(
+    BuildContext context,
+    WidgetRef ref,
+    bool enable,
+    AppSettings Function(AppSettings, bool) apply,
+  ) async {
+    if (enable) {
+      final alreadyEnabled = await ref.read(notificationServiceProvider).areEnabled();
+      if (!alreadyEnabled) {
+        if (!context.mounted) return;
+        final wantsToEnable = await showNotificationPrimingSheet(context);
+        if (wantsToEnable) {
+          await ref.read(notificationServiceProvider).requestPermission();
+        }
+      }
+    }
+    await ref.read(appSettingsProvider.notifier).update((s) => apply(s, enable));
+  }
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final settings = ref.watch(appSettingsProvider);
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        const SectionHeader(SettingsStrings.notificationsHeader, uppercase: true),
+        SwitchListTile(
+          title: const Text(SettingsStrings.notifStoreReset),
+          subtitle: const Text(SettingsStrings.notifStoreResetSubtitle),
+          value: settings.storeResetNotifications,
+          onChanged: (v) => unawaited(
+            _toggle(context, ref, v, (s, v) => s.copyWith(storeResetNotifications: v)),
+          ),
+        ),
+        SwitchListTile(
+          title: const Text(SettingsStrings.notifWishlist),
+          value: settings.wishlistNotifications,
+          onChanged: (v) => unawaited(
+            _toggle(context, ref, v, (s, v) => s.copyWith(wishlistNotifications: v)),
