+import 'package:flutter/services.dart' show Clipboard, ClipboardData;
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:valvn/core/l10n/common_strings.dart';
+import 'package:valvn/core/logging/session_log.dart';
+import 'package:valvn/features/settings/settings_strings.dart';
+import 'package:valvn/features/settings/ui/session_log_screen.dart';
+
+void main() {
+  Widget harness(SessionLog log) => ProviderScope(
+    overrides: [sessionLogProvider.overrideWithValue(log)],
+    child: const MaterialApp(home: SessionLogScreen()),
+  );
+
+  testWidgets('empty log shows the empty state', (tester) async {
+    await tester.pumpWidget(harness(SessionLog()));
+    await tester.pumpAndSettle();
+    expect(find.text(SettingsStrings.exportLogEmpty), findsOneWidget);
+  });
+
+  testWidgets('renders entries newest first with the no-secrets note', (tester) async {
+    final log = SessionLog();
+    log.add(
+      'http.get',
+      uri: Uri.parse('https://pd.ap.a.pvp.net/store/v3/storefront/11111111-1111-1111-1111-111111111111'),
+      status: 200,
+      elapsed: const Duration(milliseconds: 120),
+    );
+    log.add('reauth.ok', status: 200);
+
+    await tester.pumpWidget(harness(log));
+    await tester.pumpAndSettle();
+
+    expect(find.text(SettingsStrings.exportLogNote), findsOneWidget);
+    expect(find.textContaining('reauth.ok'), findsOneWidget);
+    expect(find.textContaining('pd.ap.a.pvp.net/store/v3/storefront/{id}'), findsOneWidget);
+    // No raw PUUID/UUID ever reaches the screen.
+    expect(find.textContaining('11111111-1111-1111-1111-111111111111'), findsNothing);
+
+    final texts = tester.widgetList<Text>(find.byType(Text)).map((t) => t.data).toList();
+    final firstEntryIndex = texts.indexWhere((t) => t?.contains('reauth.ok') ?? false);
+    final secondEntryIndex = texts.indexWhere((t) => t?.contains('http.get') ?? false);
+    expect(firstEntryIndex, lessThan(secondEntryIndex), reason: 'newest entry listed first');
+  });
+
+  testWidgets('copy button copies the exported text to the clipboard', (tester) async {
+    final log = SessionLog();
+    log.add('reauth.ok', status: 200);
+    await tester.pumpWidget(harness(log));
+    await tester.pumpAndSettle();
+
+    await tester.tap(find.byIcon(Icons.copy_outlined));
+    await tester.pumpAndSettle();
+
+    expect(find.text(CommonStrings.copied), findsOneWidget);
+    final clip = await Clipboard.getData('text/plain');
+    expect(clip?.text, contains('reauth.ok'));
+    // Auto-dismiss the snackbar so no Timer leaks past this test.
+    await tester.pump(const Duration(seconds: 5));
+  });
+
+  testWidgets('share button is present (not invoked: no plugin in tests)', (tester) async {
+    final log = SessionLog();
+    log.add('reauth.ok', status: 200);
+    await tester.pumpWidget(harness(log));
+    await tester.pumpAndSettle();
+
+    expect(find.byIcon(Icons.share_outlined), findsOneWidget);
+  });
+}
