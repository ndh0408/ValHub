# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
# Both are REQUIRED and must be at least 32 characters; the server refuses to start otherwise.

# HS256 key for community session tokens. Rotating it logs everyone out of the community tab.
SESSION_SECRET=

# Salt for user ids: id = hex(sha256(PEPPER + puuid))[0..32].
# NEVER change it after launch: every user would get a new id and lose their posts/votes.
PEPPER=

# Public origin the app reaches (the Cloudflare Tunnel hostname), used for media URLs.
# Leave empty to derive it from the request (X-Forwarded-Proto / X-Forwarded-Host).
PUBLIC_BASE_URL=https://community.example.com

# Trust CF-Connecting-IP / X-Forwarded-* headers (true behind the tunnel).
TRUST_PROXY=true

# Usually left as-is (set in docker-compose.yml).
# PORT=8080
# DATA_DIR=/data
